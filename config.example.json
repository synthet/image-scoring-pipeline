{
  "scoring_input_path": "/path/to/your/photos",
  "tagging_input_path": "",
  "stacks_input_path": "/path/to/your/photos",
  "culling_input_path": "/path/to/your/photos",
  "technical_failures": {
    "enabled": false,
    "use_classical_metrics": true,
    "use_clip_iqa": false,
    "use_pyiqa": false,
    "fail_on_detector_error": false,
    "version": "1.0.0"
  },
  "scoring": {
    "force_rescore_default": false,
    "max_image_retries": 3,
    "default_sort_by": "score_general",
    "default_sort_order": "desc",
    "fusion": {
      "general":   { "liqe": 0.35, "spaq": 0.30, "topiq": 0.13, "arniqa": 0.10, "ava": 0.12 },
      "technical": { "topiq": 0.30, "arniqa": 0.25, "spaq": 0.25, "liqe": 0.20 },
      "aesthetic": { "ava": 0.40, "spaq": 0.50, "liqe": 0.10 }
    },
    "models": {
      "spaq":   { "enabled": true,  "shadow": false },
      "ava":    { "enabled": true,  "shadow": false },
      "liqe":   { "enabled": true,  "shadow": false },
      "topiq":  { "enabled": true,  "shadow": false },
      "arniqa": { "enabled": true,  "shadow": false },
      "cursor": { "enabled": false, "shadow": false },
      "claude": { "enabled": false, "shadow": false }
    },
    "arniqa": {
      "metric": "arniqa",
      "max_dimension": 1024
    },
    "qpt_v2": {
      "checkpoint_path": "models/qpt_v2.pth",
      "max_dimension": 1024
    },
    "cursor": {
      "model": "composer-2.5",
      "max_dimension": 1024,
      "timeout_seconds": 60
    },
    "claude": {
      "model": "claude-opus-4-7",
      "max_dimension": 1024,
      "timeout_seconds": 90
    }
  },
  "percentile_anchors": {
    "liqe":   { "p02": 0.311, "p98": 0.998 },
    "ava":    { "p02": 0.301, "p98": 0.524 },
    "spaq":   { "p02": 0.257, "p98": 0.760 },
    "topiq":  { "p02": 0.390, "p98": 0.709 },
    "arniqa": { "p02": 0.467, "p98": 0.746 }
  },
  "processing": {
    "prep_queue_size": 50,
    "scoring_queue_size": 10,
    "result_queue_size": 50,
    "clustering_batch_size": 32,
    "post_run_data_quality_audit": false,
    "post_run_audit_fail_job_on_issues": false,
    "job_action_log_retention_days": 30
  },
  "clustering": {
    "stack_representative_strategy": "score",
    "best_image_alpha": 0.65,
    "default_threshold": 0.15,
    "default_time_gap": 120,
    "heal_folder_cohesion_candidates": true,
    "heal_cohesion_max_attempts": 2,
    "heal_cohesion_cooldown_hours": 168,
    "force_rescan_default": false
  },
  "culling": {
    "enabled": false,
    "default_threshold": 0.15,
    "default_time_gap": 120,
    "auto_export_default": false,
    "sub_cluster_distance_threshold": 0.05,
    "two_level": {
      "enabled": false,
      "picks_per_substack": 3,
      "max_picks_per_stack": 20,
      "reject_non_picks": true,
      "level1": {
        "embedding_space": "mobilenet_v2_imagenet_gap",
        "distance_threshold": 0.15
      },
      "level2": {
        "embedding_space": "openclip_l14_laion2b_image",
        "distance_threshold": 0.04
      },
      "diversity": {
        "enabled": true,
        "lambda": 0.70
      },
      "min_stack_size_for_substack": 3,
      "skip_single_leaf_persist": true
    },
    "clip_quality": {
      "enabled": false,
      "weight": 0.15,
      "reject_below": null,
      "_comment_reject_below": "Optional floor e.g. 0.35 (benchmark mean rejected ~0.40); enable in environment.json override"
    },
    "agent_review": {
      "enabled": false,
      "dry_run_default": false,
      "max_group_size": 200,
      "_comment_max_group_size": "Absolute safety ceiling for one agent review unit; normal oversized leaves are reviewed in review_batch_size chunks.",
      "review_batch_size": 10,
      "_comment_review_batch_size": "Max images per agent vision call when a leaf exceeds this size.",
      "min_usable_images": 2,
      "min_agent_confidence": 0.75,
      "min_group_confidence": 0.70,
      "decision_source": "pick_status",
      "allow_metadata_only_remove": false,
      "review_picked_quality": true,
      "_comment_review_picked_quality": "Emit picked-image quality advisories (e.g. misfocus on a picked hero). Advisory-only: never auto-removes or demotes picks. Surfaces via agent_decision='advisory' / candidate_status='pick_quality_advisory'.",
      "picked_audit_snippet": "picked_quality_audit_snippet_strict_v2.txt",
      "_comment_picked_audit_snippet": "Production default after 2026-06-21 A/B (stack 29157). Legacy: picked_quality_audit_snippet.txt. Compare variant: picked_quality_audit_snippet_compare.txt via vision_strict_compare_picks mode.",
      "picked_quality_hints": false,
      "_comment_picked_quality_hints": "When true, packet includes score_technical watchlist + pairwise sharper-picked context for vision audit.",
      "picked_quality_hints_threshold": 0.75,
      "picked_quality_clip_mid_low": 0.45,
      "picked_quality_clip_mid_high": 0.60,
            "agent": {
                "provider": "antigravity",
                "_comment_provider": "One of: antigravity (recommended after June 2026), gemini (API key / legacy OAuth), codex, claude (Claude Code CLI, vision via image paths), cursor (cursor-agent, vision via image paths). codex_sandbox applies to codex only.",
                "_comment_command": "Match the bridge script to the provider. Docker: /app/scripts/wsl/{antigravity,gemini,claude,cursor}_agent.sh (binary in image + auth on PATH); codex runs as the bare 'codex' binary (no bridge). WSL: /mnt/d/.../<provider>_agent.sh. The adapter appends provider-specific flags; claude/cursor need only to be logged in on PATH.",
                "command": "/app/scripts/wsl/antigravity_agent.sh",
        "model": "",
        "_comment_model": "Optional fallback when the CLI JSON envelope does not expose model name (audit log + agent_cull_review_groups.agent_model).",
        "args": [],
        "timeout_seconds": 180,
        "max_retries": 1,
        "supports_vision": true,
        "include_thumbnails": true,
        "thumbnail_mode": "path",
        "max_thumbnail_edge_px": 512,
        "include_all_model_scores": true,
        "flatten_model_scores": ["clip_quality_v0"],
        "required_score_names": ["clip_quality_v0"],
        "jit_clip_quality": true,
        "require_vision_evidence": true,
        "_comment_require_vision_evidence": "Production default true (live matrix v4 + Docker vision smoke verified thumbnail reads on stack 29157). Set false only in runtimes where Layer 2 vision smoke fails. See docs/study/agent-cull-cli-matrix.md.",
        "prompt_template_version": "cull_redundancy_v3_vision_strict",
        "_comment_prompt_template_version": "Production default v3_vision_strict (live matrix passed). Study A/B overrides: cull_redundancy_v2, v3_technical_focus, v3_score_first, v3_clip_gate via --mode-profile or matrix.",
        "_comment_mode_profile_misfocus": "For misfocus-prone stacks (e.g. 29157) operators may override with --mode-profile technical_focus.",
        "codex_sandbox": "read-only",
        "_comment_codex_sandbox": "Use workspace for study runs if read-only blocks thumbnail reads."
      },
      "local_gates": {
        "block_if_rejected_scores_higher": true,
        "score_margin": 0.0,
        "block_embedding_outliers": true,
        "outlier_z_threshold": 2.0,
        "block_unique_species": true,
        "block_unique_keywords": true,
        "block_missing_alternatives": true
      }
    }
  },
  "ui": {
    "gallery_page_size": 50,
    "default_export_format": "json"
  },
  "tagging": {
    "overwrite_default": false,
    "captions_default": true,
    "max_new_tokens": 50,
    "clip_model": "openai/clip-vit-base-patch32"
  },
  "paths": {
    "host_project_root_wsl": "",
    "host_project_root_win": ""
  },
  "database": {
    "engine": "postgres",
    "enable_api_db_query": true,
    "db_explorer_enabled": true,
    "api_db_query_max_rows": 5000,
    "write_legacy_keywords_column": true,
    "write_legacy_image_embedding_column": false,
    "write_legacy_scores_json_column": false,
    "postgres": {
      "host": "127.0.0.1",
      "port": 5432,
      "dbname": "image_scoring",
      "user": "postgres",
      "password": "postgres"
    }
  },
  "system": {
    "allowed_paths": [
      "C:/",
      "/mnt/"
    ],
    "log_dir": ".cursor",
    "log_max_bytes": 10485760,
    "log_backup_count": 5
  },
  "raw_conversion": {
    "method": "rawpy_half",
    "max_resolution": 512,
    "jpeg_quality": 85,
    "exiftool_timeout_s": 20,
    "transient_retries": 2
  },
  "auto_drive": {
    "server_loop_enabled": true,
    "self_heal_thumbnails": true,
    "self_heal_exif": true,
    "post_audit_followup": true
  },
  "runs_autodrive": {
    "treat_exhausted_failed_as_terminal": true
  },
  "embedding_map": {
    "enabled": false,
    "method": "umap",
    "n_neighbors": 30,
    "min_dist": 0.1,
    "max_points": 15000
  },
  "bird_detection": {
    "enabled": true,
    "model_repo": "synthet/bird-detect-v0",
    "model_file": "best.pt",
    "local_path": "",
    "confidence": 0.25,
    "padding": 0.06,
    "device": "auto",
    "fail_open": true
  },
  "embeddings": {
    "persist_clip_image": true,
    "persist_blip_image": true,
    "persist_bioclip_image": true,
    "reuse_clip_image_for_keywords": true,
    "culling_spaces": ["openclip_l14_laion2b_image"],
    "model_versions": {
      "clip_vit_b32_image": "openai/clip-vit-base-patch32",
      "blip_vit_b16_image": "Salesforce/blip-image-captioning-base",
      "bioclip_2_image": "hf-hub:imageomics/bioclip-2"
    }
  },
  "debug": false
}
