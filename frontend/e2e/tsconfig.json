{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["./**/*.ts"],
  "exclude": ["./.build", "./test-results", "./playwright-report"]
}
