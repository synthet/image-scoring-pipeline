{
  "_comment": "Multi-root workspace MCP template. Set folder names in image-scoring-backend.code-workspace to match. Build both mcp-server packages before enabling.",
  "mcpServers": {
    "is-be-mcp": {
      "command": "node",
      "args": ["mcp-server/dist/compactIndex.js"],
      "cwd": "${workspaceFolder:image-scoring-backend}"
    },
    "is-ui-mcp": {
      "command": "node",
      "args": ["mcp-server/dist/compactIndex.js"],
      "cwd": "${workspaceFolder:image-scoring-gallery}"
    },
    "is-be-live": {
      "_comment": "Optional — WebUI running only",
      "url": "http://127.0.0.1:7860/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${env:IMGSCORE_MCP_TOKEN}"
      }
    },
    "is-ui-live": {
      "_comment": "Optional — Electron dev running only",
      "url": "http://127.0.0.1:9373/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${env:GALLERY_MCP_TOKEN}"
      }
    },
    "fff-be": {
      "_comment": "Requires git repo cwd — do NOT register at user ~/.cursor/mcp.json. Pass explicit PATH + cwd.",
      "command": "fff-mcp",
      "args": ["${workspaceFolder:image-scoring-backend}"],
      "cwd": "${workspaceFolder:image-scoring-backend}"
    },
    "fff-gallery": {
      "_comment": "Gallery repo index — separate from fff-be in multi-root workspaces.",
      "command": "fff-mcp",
      "args": ["${workspaceFolder:image-scoring-gallery}"],
      "cwd": "${workspaceFolder:image-scoring-gallery}"
    }
  }
}
