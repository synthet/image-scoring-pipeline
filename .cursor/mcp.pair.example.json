{
  "_comment": "Multi-root: copy backend block into image-scoring-backend/.cursor/mcp.json and gallery block into image-scoring-gallery/.cursor/mcp.json. User ~/.cursor/mcp.json: github, subagent-orchestrator only.",
  "mcpServers": {
    "is-be-mcp": {
      "command": "cmd",
      "args": ["/c", "scripts\\batch\\run_mcp_compact_wsl.bat"],
      "cwd": "${workspaceFolder}"
    },
    "is-be-webui": {
      "url": "http://127.0.0.1:7860/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${env:IMGSCORE_MCP_TOKEN}"
      }
    },
    "is-ui-mcp": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp-server/dist/compactIndex.js"]
    },
    "is-ui-live": {
      "url": "http://127.0.0.1:9373/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${env:GALLERY_MCP_TOKEN}"
      }
    }
  }
}
