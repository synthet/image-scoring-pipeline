# Copy to `.env` beside docker-compose.yml (Compose loads `.env` automatically).
# `.env` is gitignored.

# Host folder → /mnt/d/Photos inside the `webui` container (New Run / scope paths).
# - Docker CLI in WSL: default in compose is /mnt/d/Photos; often no `.env` needed.
# - Docker Desktop for Windows: set this to your Windows path or the bind will not see your files.
# PHOTOS_BIND_SOURCE=D:/Photos

# Thumbnail DB columns: store host project paths instead of container /app/... (same repo root as the bind mount).
# IMAGE_SCORING_HOST_PROJECT_WSL=/mnt/d/Projects/image-scoring-backend
# IMAGE_SCORING_HOST_PROJECT_WIN=D:\Projects\image-scoring-backend

# Agent cull review: mount host CLI auth into the webui container (/root/.gemini).
# Antigravity CLI stores credentials under ~/.gemini/antigravity-cli/ after host `agy` login.
# Run agy once on the host (https://antigravity.google/download#antigravity-cli), or set an API key below.
# GEMINI_CONFIG_SOURCE=C:/Users/you/.gemini
# GEMINI_API_KEY=your_ai_studio_key
# ANTIGRAVITY_API_KEY=your_ai_studio_key

# --- Optional: native Postgres outside Docker (app reads database.* from config.json; this is for other tools / reference only) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/image_scoring
# MODEL_DIR=./models
# LOG_DIR=./logs
